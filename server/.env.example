PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/himusic
JWT_SECRET=change-this-to-a-long-random-string
# Comma separated. Add your Vercel URL after deploying the frontend.
CLIENT_ORIGIN=http://localhost:5173
# Recommended: free YouTube Data API key (makes search reliable). See README.
YOUTUBE_API_KEY=
# Optional: your own Piped / Invidious instances
# PIPED_INSTANCES=https://pipedapi.kavin.rocks
# INVIDIOUS_INSTANCES=https://yewtu.be

# ---- Login / email verification (OTP) ----
# Gmail only by default. Empty value = allow any email domain.
# ALLOWED_EMAIL_DOMAINS=gmail.com
# Private mode: only these emails can sign up (comma separated)
# ALLOWED_EMAILS=you@gmail.com,friend@gmail.com
# Pick ONE way to send the 6-digit code:
#  A) Brevo (free 300 mails/day, HTTPS - works on Render free)
# BREVO_API_KEY=
# MAIL_FROM=HiMusic <your-verified-sender@gmail.com>
#  B) Google Apps Script relay (sends from your own Gmail, see server/mail-relay.gs)
# MAIL_RELAY_URL=
# MAIL_RELAY_SECRET=
#  C) SMTP (Render free blocks SMTP ports; use on a paid host)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# Only for testing without email (NOT recommended online):
# ALLOW_UNVERIFIED_SIGNUP=true

# ---- Own audio engine (background / lock-screen playback) ----
# PUBLIC_URL=https://your-api.onrender.com
# If YouTube blocks the server IP: paste a cookies.txt (Netscape format) or use a proxy
# YT_COOKIES=
# YTDLP_PROXY=
# YTDLP_DISABLE=true   # turn the engine off

# Bytes per audio chunk the proxy returns for Range requests (default 1 MB)
# CHUNK_BYTES=1048576
# If YouTube says "Sign in to confirm you're not a bot": cookies of a throwaway account (see README)
# YT_COOKIES_B64=
# Which YouTube clients to try, in order
# YTDLP_CLIENTS=default,android_vr,tv,mweb,ios
